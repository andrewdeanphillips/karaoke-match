PORT=8080
DATABASE_URL=postgres://karaoke:karaoke@localhost:5432/karaoke_match
# Must be the same host (127.0.0.1, not localhost) as SPOTIFY_REDIRECT_URI —
# the session cookie is set against whichever host /callback runs on, and
# browsers treat localhost and 127.0.0.1 as different sites for cookie
# purposes, so a mismatch here means the frontend never sees the cookie.
FRONTEND_ORIGIN=http://127.0.0.1:5173
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback
# Optional. Names a row in spotify_sessions belonging to a Spotify account you
# control — powers the "try an example" path so visitors without a Spotify
# account can still see the app run. Leave unset to hide that path entirely.
EXAMPLE_SESSION_ID=
